{
  "extends": ["@tsconfig/svelte/tsconfig.json", "../../tsconfig.base.json"],
  "compilerOptions": {
    "types": ["svelte", "vite/client"],
    "allowImportingTsExtensions": false,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "../../packages/*/src/**/*.ts", "../../plugins/*/src/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
